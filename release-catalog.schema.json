{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scoop Linux target-indexed release catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "version", "targets"],
  "properties": {
    "format_version": { "const": 1 },
    "version": { "type": "string", "pattern": "^[\\w.\\-+_]+$", "not": { "enum": [".", "..", "current"] } },
    "main_bucket_url": { "type": ["string", "null"] },
    "targets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["architecture", "os", "libc", "abi", "url", "sha256"],
        "properties": {
          "architecture": { "type": "string" },
          "os": { "const": "linux" },
          "libc": { "enum": ["glibc", "musl-static"] },
          "abi": { "enum": ["gnu", "musl"] },
          "minimum_libc": { "type": ["string", "null"], "pattern": "^[0-9]+(?:\\.[0-9]+)*$" },
          "url": { "type": "string", "pattern": "^(https://|file://|/)" },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "required_libraries": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        },
        "if": { "properties": { "libc": { "const": "glibc" } } },
        "then": { "required": ["minimum_libc"], "properties": { "minimum_libc": { "type": "string" } } }
      }
    }
  }
}
